# ==============================================================================
# URBEN-ENTT-Frontend — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# NEVER commit .env.local or sensitive tokens to version control.
# ==============================================================================

# Public URL of the frontend website
# In local development: http://localhost:3000
# In production on Vercel: https://urben.entt or https://urben-entt.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API Base URL
# In local development: http://localhost:5000 (Express API running locally)
# In production on Vercel: https://urben-entt-backend.onrender.com (Deployed Render API URL over HTTPS)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server-side fallback for Next.js SSR / Server Components (Optional)
BACKEND_URL=http://localhost:5000
